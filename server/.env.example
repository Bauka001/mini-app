# Backend environment for local development. Copy to repo-root /.env (or
# server/.env) and the loader will pick it up when NODE_ENV !== production.
# On Vercel these go in the project's Environment Variables dashboard —
# never commit real values.

# --- Required ---

# Telegram bot token from @BotFather. Required to verify initData HMAC.
BOT_TOKEN=

# Supabase service-role key (NOT the anon key — service role bypasses RLS).
# Get from: Supabase project → Settings → API → service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Telegram IDs that are admin "from boot" without a DB row.
# Used to bootstrap the first owner; later they manage admins via UI.
ADMIN_BOOTSTRAP_TELEGRAM_IDS=

# --- Required if you use the Telegram payments webhook (/api/telegram/webhook) ---

# Public URL Telegram POSTs payment updates to. Must include /api prefix
# because Vercel routes /api/* to the function. Run server/scripts/register-webhook.js
# after setting this to register the webhook with Telegram.
TELEGRAM_WEBHOOK_URL=https://focus-game-nine.vercel.app/api/telegram/webhook

# Long random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token on
# every webhook call. Generate with `openssl rand -hex 32`. Anyone with this
# value can post arbitrary bot updates to the endpoint — treat as a secret.
TELEGRAM_WEBHOOK_SECRET=

# --- Optional ---

# Local Express port — Vercel injects PORT automatically in any non-Vercel
# host, and on Vercel functions don't listen on a port at all.
PORT=3001

# Same-origin on Vercel means CORS is unnecessary in production. Only set
# this if you run the API on a different origin than the SPA (e.g. you
# split into two Vercel projects or run a side host).
# ALLOWED_ORIGINS=https://focus-game-nine.vercel.app

# Reject Telegram initData older than this many seconds (replay protection).
INIT_DATA_MAX_AGE_SEC=300

# --- Local-dev only — must remain false in prod ---
ALLOW_DEV_AUTH_BYPASS=false
NODE_ENV=development

# Backend environment for the Render service. Copy to .env locally for dev
# (the loader auto-skips this file when NODE_ENV=production). On Render set
# these in the dashboard — never commit real values.

# --- Required ---

# Port: Render injects PORT automatically; only set locally.
PORT=3001

# CORS allowlist — comma-separated, no trailing slash. Must match your
# production frontend origin exactly.
ALLOWED_ORIGINS=https://focus-game-omega.vercel.app

# Telegram bot token from @BotFather. Required to verify initData HMAC.
BOT_TOKEN=

# Supabase service-role key (NOT the anon key — service role bypasses RLS).
# Get from: Supabase project → Settings → API → service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---

# Reject Telegram initData older than this many seconds (replay protection).
INIT_DATA_MAX_AGE_SEC=300

# Comma-separated Telegram IDs that are admin "from boot" without DB row.
# Used to bootstrap the first owner; later they manage admins via UI.
ADMIN_BOOTSTRAP_TELEGRAM_IDS=

# --- Local-dev only — must be false in prod ---
ALLOW_DEV_AUTH_BYPASS=false
NODE_ENV=development

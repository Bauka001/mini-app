# ===============================
# Dependencies
# (yarn is the only supported package manager — block other lockfiles)
# ===============================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
package-lock.json
pnpm-lock.yaml
bun.lockb

# ===============================
# Build output
# ===============================
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# ===============================
# Testing & coverage
# ===============================
coverage/
.nyc_output/

# ===============================
# Logs
# ===============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===============================
# Environment variables
# (commit only .env.example with placeholder values)
# ===============================
.env
.env.*
!.env.example

# ===============================
# Editors / IDEs / AI tools
# ===============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.fleet/
.cursor/
.trae/
.aider*
.claude/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===============================
# OS-generated files
# ===============================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ===============================
# Deployment platforms
# ===============================
.vercel/
.netlify/

# ===============================
# Temporary / backup files
# ===============================
*.tmp
*.temp
*.bak
*.orig
.vercel

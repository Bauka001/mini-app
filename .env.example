# Admin bootstrap
ADMIN_BOOTSTRAP_TELEGRAM_IDS=5357445431

# Browser-based Admin Panel V2 (login from any browser via /admin)
ADMIN_PANEL_LOGIN=admin
ADMIN_PANEL_PASSWORD=change-me-please
# Optional: owner Telegram ID written into audit log for browser admin actions
# (defaults to first ADMIN_BOOTSTRAP_TELEGRAM_IDS entry).
ADMIN_PANEL_OWNER_TG_ID=5357445431

# Backend
VITE_API_URL=http://localhost:3001
# Production-та міндетті түрде backend URL көрсету керек, әйтпесе auth/API сұраулары frontend доменіне кетіп, Mini App ашылмай қалуы мүмкін.
BOT_TOKEN=your_telegram_bot_token_here
# Telegram Stars webhook — public HTTPS URL pointing at /payments/stars/webhook
# Local test: ngrok http 3001 → https://xxxx.ngrok-free.dev/payments/stars/webhook
WEBHOOK_URL=https://your-domain.com/payments/stars/webhook
TON_WALLET_ADDRESS=UQDLmGexGMYJs5eTKBNWyswx8Sr_xg5yLUC3ZZOY-aKuW35x
TONCENTER_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=

# Backend security
# Comma-separated list of allowed CORS origins (no trailing slash). Required for production.
ALLOWED_ORIGINS=https://focus-game-nine.vercel.app
# Reject Telegram initData older than this many seconds (replay protection).
INIT_DATA_MAX_AGE_SEC=300
# Set to "true" only on a local dev machine to bypass initData when not using Telegram.
# Never set this in production.
ALLOW_DEV_AUTH_BYPASS=false

# Telegram bot webhook
# Random opaque string. Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token
# on every webhook call; we reject calls without a match. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-32-bytes-of-random-hex
# Public URL the webhook is registered at. Must match where this server is reachable.
# Example: https://focus-api.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-server-domain/telegram/webhook
# Public URL of the Mini App, sent by the /start handler as a launch link.
MINI_APP_URL=https://focus-game-nine.vercel.app

# Supabase (Required for persistent storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Backend uses SUPABASE_URL (falls back to VITE_SUPABASE_URL) + service role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Edge Function (payment-webhook)
# Shared secret required in the x-webhook-secret header on every webhook call.
WEBHOOK_SECRET=replace-with-a-long-random-string

# Telegram Mini Apps Analytics SDK
# Issued by @DataChief_bot or via TON Builders -> Profile -> Analytics tab.
# Required by the Telegram Apps Center moderation pipeline; without it the SDK
# is not initialised and the build still works for local dev.
# Treat as secret — do not commit a real value, only set it in Vercel envs.
VITE_TG_ANALYTICS_TOKEN=
# Logical app name (the "Identifier" shown on TON Builders / DataChief).
VITE_TG_ANALYTICS_APP_NAME=focus_game

# Adsgram rewarded-ad Block ID (https://adsgram.ai → create a "Rewarded" block).
# Powers the "watch ad → earn coins" card and ad-revive. While empty, the reward
# flow still works WITHOUT showing an ad (interim, capped 5/day by the backend);
# set the real Block ID to start serving real ads. Example value: "1234".
VITE_ADSGRAM_BLOCK_ID=

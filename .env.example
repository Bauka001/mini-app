# Admin bootstrap
ADMIN_BOOTSTRAP_TELEGRAM_IDS=17096844

# Backend
VITE_API_URL=http://localhost:3001
BOT_TOKEN=your_telegram_bot_token_here

# Backend security
# Comma-separated list of allowed CORS origins (no trailing slash). Required for production.
ALLOWED_ORIGINS=https://focus-game-nine.vercel.app
# Reject Telegram initData older than this many seconds (replay protection).
INIT_DATA_MAX_AGE_SEC=300
# Set to "true" only on a local dev machine to bypass initData when not using Telegram.
# Never set this in production.
ALLOW_DEV_AUTH_BYPASS=false

# Telegram bot webhook
# Random opaque string. Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token
# on every webhook call; we reject calls without a match. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-32-bytes-of-random-hex
# Public URL the webhook is registered at. Must match where this server is reachable.
# Example: https://focus-api.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-server-domain/telegram/webhook

# Supabase (Required for persistent storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Edge Function (payment-webhook)
# Shared secret required in the x-webhook-secret header on every webhook call.
WEBHOOK_SECRET=replace-with-a-long-random-string
